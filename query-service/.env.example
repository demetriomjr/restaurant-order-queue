# Query Service - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste conforme necessário

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_order?schema=public"

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_QUEUE_NAME="query_service_order_projection"

# CORS - Origins permitidas (separadas por vírgula)
CORS_ORIGIN="http://localhost:6173,http://localhost:6174"

# Porta padrão (será incrementada se estiver em uso)
PORT=4002

# Node environment
NODE_ENV="development"
